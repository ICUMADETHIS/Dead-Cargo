# Dead Cargo - Unity 6 project .gitignore
# Based on github/gitignore Unity.gitignore, extended for this project.
#
# TRACKED: Assets/, Packages/, ProjectSettings/, Docs/, and every .meta file.
# IGNORED: everything Unity, the IDE, or the OS can regenerate.

# --- Unity generated folders (root only) ---------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild*/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# --- Unity generated files -------------------------------------------------
sysinfo.txt
mono_crash.*
crashlytics-build.properties
*.log

# Play mode test runner scenes
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
InitTestScene*.unity*

# Addressables build output
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Visual Scripting generated caches
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# --- Build artifacts -------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# --- IDE: Visual Studio / Rider / VS Code (solution files are regenerated by Unity)
.vs/
.idea/
.vscode/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.pidb.meta
*.booproj
*.svd
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- DCC tool backups ------------------------------------------------------
*.blend1
*.blend1.meta
*.tmp

# --- OS junk ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Personal tool settings ------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md

# --- Stray files that are not part of the project --------------------------
/[Aa]ssets/_www.unityassetcollection.com.txt
/[Aa]ssets/_www.unityassetcollection.com.txt.meta
