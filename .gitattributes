# Dead Cargo - Unity 6 project .gitattributes
# Requires: Force Text serialization + Visible Meta Files (Project Settings > Editor).
#
# Line endings: git stores text with LF inside the repository. Files on disk are
# only written by git on checkout/restore, using the endings Unity and the IDE
# already use (LF for Unity YAML, OS-native for code). Binary files are never touched.

# --- Default: let git detect text and store it with LF in the repo -----------
* text=auto

# --- Code and plain text (working-tree line endings follow the OS) -----------
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.compute   text
*.asmdef    text
*.asmref    text
*.uss       text
*.uxml      text
*.json      text
*.xml       text
*.yml       text
*.yaml      text
*.md        text
*.txt       text

# --- Unity YAML: always text, always LF (Unity writes LF on every platform) --
# merge=unityyamlmerge uses Unity's Smart Merge (configured in .git/config);
# without it, git falls back to its normal text merge.
*.unity             text eol=lf merge=unityyamlmerge
*.prefab            text eol=lf merge=unityyamlmerge
*.mat               text eol=lf merge=unityyamlmerge
*.meta              text eol=lf merge=unityyamlmerge
*.anim              text eol=lf merge=unityyamlmerge
*.controller        text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.mask              text eol=lf merge=unityyamlmerge
*.mixer             text eol=lf merge=unityyamlmerge
*.playable          text eol=lf merge=unityyamlmerge
*.signal            text eol=lf merge=unityyamlmerge
*.preset            text eol=lf merge=unityyamlmerge
*.brush             text eol=lf merge=unityyamlmerge
*.flare             text eol=lf merge=unityyamlmerge
*.lighting          text eol=lf merge=unityyamlmerge
*.terrainlayer      text eol=lf merge=unityyamlmerge
*.physicMaterial    text eol=lf merge=unityyamlmerge
*.physicmaterial    text eol=lf merge=unityyamlmerge
*.renderTexture     text eol=lf merge=unityyamlmerge
*.cubemap           text eol=lf merge=unityyamlmerge
*.spriteatlas       text eol=lf merge=unityyamlmerge
*.spriteatlasv2     text eol=lf merge=unityyamlmerge
*.shadergraph       text eol=lf
*.shadersubgraph    text eol=lf
*.inputactions      text eol=lf

# .asset is YAML *most* of the time, but Unity always writes some of them as
# binary even in Force Text mode (LightingData, TerrainData, NavMesh data).
# text=auto lets git detect those and store them byte-for-byte instead of
# corrupting them with line-ending conversion.
*.asset             text=auto eol=lf merge=unityyamlmerge

# Known binary .asset files: never convert, diff or merge.
LightingData.asset  binary
*Terrain.asset      binary
NavMesh*.asset      binary
# Huge generated YAML: store as text but never try to merge it.
OcclusionCullingData.asset -merge

# --- Binary project assets -------------------------------------------------
# Bracket patterns keep matches case-insensitive on every OS (e.g. FONT.TTF).

# Images / textures
*.[pP][nN][gG]       binary
*.[jJ][pP][gG]       binary
*.[jJ][pP][eE][gG]   binary
*.[pP][sS][dD]       binary
*.[tT][gG][aA]       binary
*.[tT][iI][fF]       binary
*.[tT][iI][fF][fF]   binary
*.[eE][xX][rR]       binary
*.[hH][dD][rR]       binary
*.[bB][mM][pP]       binary
*.[gG][iI][fF]       binary

# 3D models
*.[fF][bB][xX]       binary
*.[oO][bB][jJ]       binary
*.[bB][lL][eE][nN][dD] binary
*.[dD][aA][eE]       binary
*.3[dD][sS]          binary

# Audio
*.[wW][aA][vV]       binary
*.[mM][pP]3          binary
*.[oO][gG][gG]       binary
*.[aA][iI][fF]       binary
*.[aA][iI][fF][fF]   binary
*.[fF][lL][aA][cC]   binary

# Fonts
*.[tT][tT][fF]       binary
*.[oO][tT][fF]       binary

# Video
*.[mM][pP]4          binary
*.[mM][oO][vV]       binary
*.[wW][eE][bB][mM]   binary

# Documents, archives, native plugins
*.[pP][dD][fF]       binary
*.[zZ][iI][pP]       binary
*.7[zZ]              binary
*.[dD][lL][lL]       binary
*.[sS][oO]           binary
